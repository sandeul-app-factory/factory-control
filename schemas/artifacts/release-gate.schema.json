{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.sandeul.work/schemas/artifacts/release-gate.schema.json",
  "title": "Factory Release Gate Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "blockers", "checks"],
  "properties": {
    "passed": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
