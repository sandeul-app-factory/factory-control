{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.sandeul.work/schemas/artifacts/security-report.schema.json",
  "title": "Factory Security Scan Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["commitSha", "scanner", "status", "findings"],
  "properties": {
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "scanner": { "type": "string", "minLength": 1, "maxLength": 100 },
    "status": { "enum": ["PASSED", "FAILED", "CANCELLED"] },
    "sbomArtifactId": { "type": "string", "format": "uuid" },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["fingerprint", "severity", "ruleId", "title", "description"],
        "properties": {
          "fingerprint": { "type": "string", "minLength": 1, "maxLength": 300 },
          "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "description": { "type": "string", "minLength": 1, "maxLength": 20000 }
        }
      }
    }
  }
}
