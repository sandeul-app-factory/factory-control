{
  "name": "@sandeul/database",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "admin:create": "tsx src/cli/create-admin.ts",
    "mcp:create-credential": "tsx src/cli/create-mcp-credential.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "argon2": "0.45.1",
    "prisma": "6.19.0"
  },
  "devDependencies": {
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
