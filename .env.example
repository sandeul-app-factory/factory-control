NODE_ENV=development
TZ=Asia/Seoul

# Public endpoints
FACTORY_PUBLIC_URL=https://factory.sandeul.work
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://api:4000
WEB_INTERNAL_URL=http://web:3000
API_PORT=4000

# Database
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=
POSTGRES_BIND_PORT=5432
DATABASE_URL=postgresql://factory:CHANGE_ME@postgres:5432/factory?schema=public

# Redis / Queue
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_BIND_PORT=6379
CODEX_QUEUE_NAME=codex-tasks
CODEX_CONCURRENCY=1
CODEX_JOB_TIMEOUT_MS=1800000
CODEX_JOB_MAX_ATTEMPTS=3

# Application authentication
SESSION_COOKIE_NAME=factory_session
SESSION_TTL_HOURS=12
SESSION_SECURE=true
SESSION_SAME_SITE=lax
AUTH_ALLOWED_ORIGINS=https://factory.sandeul.work,http://localhost:3000
AUDIT_HASH_PEPPER=
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Initial administrator CLI input (do not commit real values)
ADMIN_LOGIN_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=factory-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=52428800
MAX_JSON_BODY_BYTES=3145728
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# GitHub App preferred; PAT is optional fallback
GITHUB_ADAPTER=fake
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_FINE_GRAINED_PAT=
GITHUB_API_URL=https://api.github.com
FAKE_GITHUB_OWNER=sandeul

# Codex worker
CODEX_ADAPTER=fake
CODEX_BIN=codex
CODEX_WORKSPACE_ROOT=/srv/factory-workspaces
CODEX_WORKSPACE_CLEANUP=true
CODEX_SANDBOX=workspace-write
CODEX_RESULT_SCHEMA_PATH=/opt/sandeul-factory/schemas/codex/codex-result.schema.json
CODEX_ALLOWED_TEST_COMMANDS=pnpm test,pnpm lint,pnpm typecheck,./gradlew test,./gradlew lint

# MCP is disabled by default
MCP_ENABLED=false
MCP_TOKEN_PEPPER=
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_ALLOWED_ORIGINS=https://factory.sandeul.work
MCP_MAX_PRD_BYTES=2097152
MCP_CREDENTIAL_NAME=
MCP_CREDENTIAL_SCOPES=factory.list_projects,factory.get_project,factory.get_project_status
MCP_CREDENTIAL_RATE_LIMIT=30
MCP_CREDENTIAL_EXPIRES_AT=

# Signing is disabled until a dedicated worker is configured
SIGNING_WORKER_ENABLED=false
SIGNING_WORKER_ENDPOINT=

# Local bind / reverse proxy
API_BIND_PORT=4000
WEB_BIND_PORT=3000
FACTORY_GATEWAY_PORT=8080

# Operations
BACKUP_ROOT=/srv/backups/sandeul-factory
BACKUP_RETENTION_DAYS=30
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CREDENTIAL_FILE=
