NODE_ENV=development
TZ=Asia/Seoul

# Public endpoints
FACTORY_PUBLIC_URL=https://factory.sandeul.work
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://api:4000
WEB_INTERNAL_URL=http://web:3000
API_PORT=4000

# Database
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://factory:CHANGE_ME@postgres:5432/factory?schema=public

# Redis / Queue
REDIS_URL=redis://redis:6379
CODEX_QUEUE_NAME=codex-tasks
CODEX_CONCURRENCY=1
CODEX_JOB_TIMEOUT_MS=1800000
CODEX_JOB_MAX_ATTEMPTS=3

# Application authentication
SESSION_COOKIE_NAME=factory_session
SESSION_TTL_HOURS=12
SESSION_SECURE=true
SESSION_SAME_SITE=lax
AUTH_ALLOWED_ORIGINS=https://factory.sandeul.work,http://localhost:3000
AUDIT_HASH_PEPPER=
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Initial administrator CLI input (do not commit real values)
ADMIN_LOGIN_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=factory-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=52428800

# GitHub App preferred; PAT is optional fallback
GITHUB_ADAPTER=fake
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_FINE_GRAINED_PAT=
GITHUB_API_URL=https://api.github.com

# Codex worker
CODEX_ADAPTER=fake
CODEX_BIN=codex
CODEX_WORKSPACE_ROOT=/srv/factory-workspaces
CODEX_SANDBOX=workspace-write
CODEX_ALLOWED_TEST_COMMANDS=pnpm test,pnpm lint,pnpm typecheck,./gradlew test,./gradlew lint

# MCP is disabled by default
MCP_ENABLED=false
MCP_TOKEN_PEPPER=
MCP_RATE_LIMIT_PER_MINUTE=30

# Signing is disabled until a dedicated worker is configured
SIGNING_WORKER_ENABLED=false
SIGNING_WORKER_ENDPOINT=
