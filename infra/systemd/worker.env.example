NODE_ENV=production
TZ=Asia/Seoul
DATABASE_URL=
REDIS_URL=
CODEX_ADAPTER=real
CODEX_BIN=/usr/local/bin/codex
CODEX_SANDBOX=workspace-write
CODEX_QUEUE_NAME=codex-tasks
CODEX_CONCURRENCY=1
CODEX_JOB_TIMEOUT_MS=1800000
CODEX_JOB_MAX_ATTEMPTS=3
CODEX_WORKSPACE_ROOT=/srv/factory-workspaces
CODEX_WORKSPACE_CLEANUP=true
CODEX_RESULT_SCHEMA_PATH=/opt/sandeul-app-factory/schemas/codex/codex-result.schema.json
CODEX_ALLOWED_TEST_COMMANDS=./gradlew test,./gradlew lint,./gradlew detekt,./gradlew ktlintCheck
GITHUB_ADAPTER=app
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_FINE_GRAINED_PAT=
GITHUB_API_URL=https://api.github.com
