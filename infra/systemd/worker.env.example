NODE_ENV=production
TZ=Asia/Seoul
DATABASE_URL=
REDIS_URL=
CODEX_ADAPTER=real
CODEX_BIN=/usr/local/bin/codex
CODEX_HOME=/var/lib/factory-codex/.codex
CODEX_SANDBOX=workspace-write
CODEX_QUEUE_NAME=codex-tasks
CODEX_CONCURRENCY=1
CODEX_JOB_TIMEOUT_MS=10800000
CODEX_JOB_MAX_ATTEMPTS=3
CODEX_WORKSPACE_ROOT=/srv/factory-workspaces
CODEX_WORKSPACE_CLEANUP=true
CODEX_RESULT_SCHEMA_PATH=/opt/sandeul-app-factory/schemas/codex/codex-result.schema.json
CODEX_ALLOWED_TEST_COMMANDS=./gradlew test,./gradlew lint,./gradlew detekt,./gradlew ktlintCheck
JAVA_HOME=/usr/lib/jvm/java-17-openjdk
ANDROID_HOME=/opt/android-sdk
GRADLE_USER_HOME=/srv/factory-workspaces/.gradle
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=https://factory.sandeul.work
S3_REGION=auto
S3_BUCKET=factory-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_BUILD_ARTIFACT_BYTES=536870912
GITLEAKS_BIN=/usr/local/bin/gitleaks
SEMGREP_BIN=/usr/local/bin/semgrep
TRIVY_BIN=/usr/local/bin/trivy
OSV_SCANNER_BIN=/usr/local/bin/osv-scanner
SYFT_BIN=/usr/local/bin/syft
MOBSF_ENDPOINT=
GITHUB_ADAPTER=app
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_FINE_GRAINED_PAT=
GITHUB_API_URL=https://api.github.com
