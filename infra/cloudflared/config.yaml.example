# Reviewable ingress mirror for the existing, remotely-managed Sandeul_tunnel_v1 tunnel.
# Keep credentials outside the repository and mount them read-only.
# Do not merge this file into or overwrite the boss-guild-event tunnel configuration.
# Apply equivalent ingress rules in Cloudflare; remote configuration is authoritative.
tunnel: 0bcebddc-8c98-4921-ae4e-50f681bdfb2b
credentials-file: /etc/cloudflared/credentials/0bcebddc-8c98-4921-ae4e-50f681bdfb2b.json

ingress:
  - hostname: factory.sandeul.work
    service: http://host.docker.internal:8080
    originRequest:
      connectTimeout: 10s
      noHappyEyeballs: false
      httpHostHeader: factory.sandeul.work
  - service: http_status:404
